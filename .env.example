VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_ENABLE_META_PUBLICATION_PROVIDER="false"

# F1 — Cérebro v2: alterna entre edge function `chat` (v1) e `chat-v2` (RAG + Anthropic).
# Use "on" depois que ANTHROPIC_API_KEY e OPENAI_API_KEY estiverem configurados nos
# secrets do Supabase E as migrations F1 estiverem aplicadas.
VITE_ORION_CHAT_V2="off"
# Compatibilidade com o nome antigo do flag. Use "true" para ligar chat-v2.
VITE_USE_CHAT_V2="false"

# F2 — gerar variantes via Copywriter agente (qualidade superior ao template hardcoded).
# Requer F1 ativo (edge function chat-v2 e Anthropic key configurada).
VITE_ORION_AI_VARIANTS="off"

# F2 — geração de imagem por variante via Replicate FLUX.
# Requer REPLICATE_API_TOKEN nos secrets do Supabase + bucket `creative-assets` migrado.
VITE_ORION_IMAGE_GEN="off"
