# ─── Supabase ────────────────────────────────────────────────────────────────
# Encontre em: https://app.supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."   # chave anon/public

# ─── Feature flags ───────────────────────────────────────────────────────────
# F1 — Chat v2 com RAG + Anthropic. Requer ANTHROPIC_API_KEY nos secrets do Supabase.
VITE_ORION_CHAT_V2=on

# F2 — Variantes de criativo via IA. Requer F1 ativo.
VITE_ORION_AI_VARIANTS=on

# F2 — Geração de imagem via Replicate FLUX. Requer REPLICATE_API_TOKEN nos secrets.
VITE_ORION_IMAGE_GEN=on

# ─── Dev only ────────────────────────────────────────────────────────────────
# Auto-login como demo@orion.local. NUNCA ative em produção.
VITE_DEV_AUTH_BYPASS=false
